datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
  STAFF
}

enum ComponentCategory {
  CPU          // Bộ vi xử lý
  VGA          // Card màn hình
  MAINBOARD    // Bo mạch chủ
  RAM          // Bộ nhớ trong
  STORAGE      // Ô cứng SSD / HDD
  PSU          // Nguồn máy tính
  CASE         // Vỏ máy tính
  COOLING      // Tản nhiệt
  MONITOR      // Màn hình
  GEAR         // Gaming gear tổng hợp
  KEYBOARD     // Bàn phím cơ & Chuột
  HEADSET      // Tai nghe gaming & Âm thanh
  LAPTOP       // Laptop văn phòng & Mỏng nhẹ
  LAPTOP_GAMING // Laptop gaming & Đồ họa
  PREBUILT_PC  // PC Gắn sẵn / PC Đồng bộ
}

enum OrderStatus {
  PENDING           // Chờ xác nhận
  CONFIRMED         // Đã xác nhận & Đóng gói
  SHIPPING          // Đang giao hàng
  COMPLETED         // Đã hoàn thành
  CANCELLED         // Đã hủy
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  VIETQR        // Mã QR Chuyển khoản ngân hàng tự động
  COD           // Thanh toán khi nhận hàng
  PAYOS         // Cổng thanh toán PayOS
  MOMO          // Ví MoMo
  WALLET        // Số dư tài khoản
}

enum SerialStatus {
  AVAILABLE     // Đang trong kho
  SOLD          // Đã bán cho khách
  WARRANTY      // Đang bảo hành
}

model User {
  id            String        @id @default(uuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  address       String?
  role          Role          @default(USER)
  balance       Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  orders        Order[]
  transactions  Transaction[]
  reviews       Review[]
}

model Product {
  id             String            @id @default(uuid())
  name           String
  slug           String            @unique
  description    String            @db.Text
  price          Decimal           @db.Decimal(12, 2)
  discountPrice  Decimal?          @db.Decimal(12, 2)
  costPrice      Decimal?          @db.Decimal(12, 2) // Giá nhập kho để tính lợi nhuận
  category       ComponentCategory
  brand          String            // ASUS, MSI, Gigabyte, Intel, AMD, Corsair...
  modelCode      String?           // Mã SKU / Part number của NSX
  coverImage     String
  screenshots    String[]          // Gallery hình ảnh
  
  // Thông số dùng cho PC Builder & Lọc tương thích
  socket         String?           // LGA1700, AM5, AM4...
  ramType        String?           // DDR4, DDR5...
  wattage        Int?              // Công suất tiêu thụ Watt (CPU/VGA) hoặc công suất cung cấp (PSU)
  formFactor     String?           // ATX, Micro-ATX, ITX...
  specs          Json?             // Chi tiết thông số kỹ thuật dạng JSON

  warrantyMonths Int               @default(24) // Thời gian bảo hành (tháng)
  stockQuantity  Int               @default(10) // Số lượng tồn kho
  status         Boolean           @default(true) // Bật/Tắt hiển thị
  isFlashDeal    Boolean           @default(false)
  isFeatured     Boolean           @default(false)
  isPrebuilt     Boolean           @default(false)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  serials        ProductSerial[]
  orderItems     OrderItem[]
  reviews        Review[]
}

model ProductSerial {
  id           String       @id @default(uuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNumber String       @unique // Mã Serial vật lý trên vỏ hộp/tem
  status       SerialStatus @default(AVAILABLE)
  soldDate     DateTime?
  warrantyEnd  DateTime?
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([productId, status])
}

model Order {
  id              String        @id @default(uuid())
  orderCode       String        @unique // Mã đơn hàng (VD: ODS1001)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Thông tin giao hàng
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String
  deliveryType    String        @default("DELIVERY") // DELIVERY (Giao hàng) hoặc STORE_PICKUP (Nhận tại cửa hàng)
  notes           String?       @db.Text

  totalAmount     Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  netAmount       Decimal       @db.Decimal(12, 2)
  
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(VIETQR)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentDetails  Json?
  couponCode      String?
  coupon          Coupon?       @relation(fields: [couponCode], references: [code])
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orderItems      OrderItem[]
  serials         ProductSerial[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(12, 2)
  serialsList String[] // Lưu danh sách Serial đã xuất cho sản phẩm này trong đơn
}

model Transaction {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal           @db.Decimal(12, 2)
  type           String            // DEPOSIT, PURCHASE, REFUND
  status         String            // PENDING, SUCCESS, FAILED
  paymentGateway PaymentMethod
  referenceId    String?           @unique
  description    String?
  createdAt      DateTime          @default(now())
}

model Coupon {
  code          String    @id @unique
  discountType  String    // PERCENT hoặc FIXED
  discountValue Decimal   @db.Decimal(10, 2)
  minOrderValue Decimal?  @db.Decimal(12, 2)
  maxDiscount   Decimal?  @db.Decimal(12, 2)
  expiresAt     DateTime
  maxUses       Int
  usedCount     Int       @default(0)
  createdAt     DateTime  @default(now())

  orders        Order[]
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String   @db.Text
  createdAt DateTime @default(now())
}

